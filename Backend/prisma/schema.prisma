generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TECHNICIAN
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  ACCEPTED
  IN_PROGRESS
  WAITING_CONFIRM
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  ELECTRICAL
  PLUMBING
  AIR_CONDITIONER
  PAINTING
  CONSTRUCTION
  FURNITURE
  CLEANING
  OTHER
}

enum ChatType {
  MESSAGE
  IMAGE
  PRICE_OFFER
  PRICE_ACCEPT
  PRICE_REJECT
}

model users {
  Users_Id Int @id @default(autoincrement())
  Email    String @unique
  Password String
  Role   Role
  Status Status @default(ACTIVE)
  Created_At DateTime @default(now())
  Updated_At DateTime @updatedAt
  Profile profiles?
  Services services[]
  CustomerOrders orders[] @relation("CustomerOrders")
  TechnicianOrders orders[] @relation("TechnicianOrders")
  Addresses addresses[]
  ServiceAreas service_areas[]
}

model service_areas {
  Area_Id Int @id @default(autoincrement())
  Users_Id Int
  Province String
  District String?
  Created_At DateTime @default(now())
  User users @relation(fields: [Users_Id], references: [Users_Id])
}

model profiles {
  Profile_Id      Int      @id @default(autoincrement())
  Users_Id        Int      @unique
  First_Name      String?
  Last_Name       String?
  Phone           String?
  Avatar          String?
  Gender          Gender?
  Birth_Date      DateTime?
  Created_At      DateTime @default(now())
  Updated_At      DateTime @updatedAt
  User users @relation(fields: [Users_Id], references: [Users_Id])
}

model addresses {
  Address_Id Int @id @default(autoincrement())
  Users_Id Int
  Address String?
  Province String?
  District String?
  Subdistrict String?
  Postal_Code String?
  Latitude Float
  Longitude Float
  Is_Default Boolean @default(false)
  Created_At DateTime @default(now())
  Updated_At DateTime @updatedAt
  User users @relation(fields: [Users_Id],references: [Users_Id])
}

model services {
  Service_Id  Int               @id @default(autoincrement())
  Users_Id    Int
  Title       String
  Category    ServiceCategory
  Description String?
  Price       Float
  Image       String?
  Created_At  DateTime          @default(now())
  Updated_At  DateTime          @updatedAt

  User   users   @relation(fields: [Users_Id], references: [Users_Id])
  Orders orders[]
  Chats  chats[]
}

model orders {
  Order_Id       Int         @id @default(autoincrement())
  Users_Id       Int
  Tech_Id        Int
  Service_Id     Int
  Final_Price    Float?
  Work_Date      DateTime?
  Work_Date_End  DateTime?
  Status         OrderStatus @default(ACCEPTED)
  Created_At     DateTime    @default(now())
  Updated_At     DateTime    @updatedAt
  User users @relation("CustomerOrders", fields: [Users_Id], references: [Users_Id])
  TechUser users @relation("TechnicianOrders", fields: [Tech_Id], references: [Users_Id])
  Service services @relation(fields: [Service_Id], references: [Service_Id])
  Review  reviews?
  BOQ boqs?
}

model boqs {
  BOQ_Id       Int      @id @default(autoincrement())
  Order_Id     Int      @unique
  Total_Amount Float    @default(0)
  Created_At   DateTime @default(now())
  Updated_At   DateTime @updatedAt
  Order orders @relation(fields: [Order_Id], references: [Order_Id])
  Items boq_items[]
}

model boq_items {
  BOQ_Item_Id  Int      @id @default(autoincrement())
  BOQ_Id       Int
  Name         String
  Description  String?
  Quantity     Float
  Unit         String
  Unit_Price   Float
  Total_Price  Float
  Created_At   DateTime @default(now())
  Updated_At   DateTime @updatedAt
  BOQ boqs @relation(fields: [BOQ_Id], references: [BOQ_Id])
}

model reviews {
  Review_Id  Int      @id @default(autoincrement())
  Order_Id   Int      @unique
  Rating     Int
  Comment    String?
  Created_At DateTime @default(now())

  Order orders @relation(fields: [Order_Id], references: [Order_Id])
}

model chats {
  Chat_Id        Int       @id @default(autoincrement())
  Service_Id     Int
  Room_Id        String
  Sender_Id      Int
  Receiver_Id    Int
  Type           ChatType  @default(MESSAGE)
  Message        String?
  Price          Float?
  Work_Date      DateTime?
  Work_Date_End  DateTime?
  Image          String?
  Created_At     DateTime  @default(now())
  Service services @relation(fields: [Service_Id], references: [Service_Id])
}

model provinces {
  Province_Id Int @id @default(autoincrement())
  Name String @unique
  Districts districts[]
  Created_At DateTime @default(now())
  Updated_At DateTime @updatedAt
}

model districts {
  District_Id Int @id @default(autoincrement())
  Province_Id Int
  Name String
  Province provinces @relation(fields: [Province_Id],references: [Province_Id])
  Subdistricts subdistricts[]
  Created_At DateTime @default(now())
  Updated_At DateTime @updatedAt
}

model subdistricts {
  Subdistrict_Id Int @id @default(autoincrement())
  District_Id Int
  Name String
  Postal_Code String?
  District districts @relation(fields: [District_Id],references: [District_Id])
  Created_At DateTime @default(now())
  Updated_At DateTime @updatedAt
}